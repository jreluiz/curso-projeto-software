---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#0f766e"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
    edgeLabelBackground: "#fdfdfb"
    clusterBkg: "#fdfdfb"
    clusterBorder: "#0f766e"
---
flowchart LR
    RN["<b>RN-05</b><br/>regra de negócio"]
    H["<b>H-03</b><br/>história"]
    CA["<b>Critérios<br/>de aceite</b>"]
    G["<b>Cenário<br/>Gherkin</b>"]
    T["<b>Teste<br/>automatizado</b>"]

    RN --> H --> CA --> G --> T

    classDef dominio fill:#fdf1e6,stroke:#e76f00,stroke-width:3px,color:#3a2000
    classDef spec fill:#e7f2f0,stroke:#0f766e,stroke-width:3px,color:#0f2f2b
    class RN dominio
    class H,CA,G,T spec
