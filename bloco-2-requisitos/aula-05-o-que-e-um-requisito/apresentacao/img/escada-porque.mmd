---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#0f766e"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
    edgeLabelBackground: "#fdfdfb"
    clusterBkg: "#fdfdfb"
    clusterBorder: "#0f766e"
---
flowchart LR
    P["<b>Pedido</b><br/>'um botão vermelho<br/>no canto direito'"]
    Q1["<b>Por quê?</b><br/>'não acham<br/>onde cancelar'"]
    Q2["<b>E por que<br/>isso importa?</b><br/>'quando não acham,<br/>não aparecem'"]
    R["<b>Requisito</b><br/>O solicitante deve poder<br/>cancelar uma reserva futura,<br/>liberando a sala."]

    P --> Q1 --> Q2 --> R

    classDef solucao fill:#fdeeeb,stroke:#c0392b,stroke-width:3px,color:#3a0f0a
    classDef meio fill:#fdf1e6,stroke:#e76f00,stroke-width:3px,color:#3a2000
    classDef req fill:#e7f2f0,stroke:#0f766e,stroke-width:3px,color:#0f2f2b
    class P solucao
    class Q1,Q2 meio
    class R req
