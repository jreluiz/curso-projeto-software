---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#0f766e"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
    edgeLabelBackground: "#fdfdfb"
    clusterBkg: "#fdfdfb"
    clusterBorder: "#0f766e"
---
%% Matriz 2×2: linhas = esforço (os subgraphs), colunas = valor.
%% O mermaid ignora o `direction` interno e o `LR` externo quando os
%% subgraphs não têm aresta entre si — e os empilha na ordem INVERSA
%% da declaração. Daí "Esforço alto" vir escrito primeiro: é o que põe
%% "Faça primeiro" no canto superior esquerdo, onde a leitura começa.
flowchart LR
    subgraph EA["Esforço alto"]
      direction TB
      B["<b>Planeje e quebre</b><br/>valor alto<br/><i>vale a pena — fatie</i>"]
      D["<b>Não faça</b><br/>valor baixo<br/><i>e escreva por que não</i>"]
    end
    subgraph EB["Esforço baixo"]
      direction TB
      A["<b>Faça primeiro</b><br/>valor alto<br/><i>consultar disponibilidade</i>"]
      C["<b>Faça se sobrar</b><br/>valor baixo<br/><i>não deixe encher a fila</i>"]
    end

    classDef bom fill:#e7f2f0,stroke:#0f766e,stroke-width:3px,color:#0f2f2b
    classDef medio fill:#fdf1e6,stroke:#e76f00,stroke-width:3px,color:#3a2000
    classDef ruim fill:#fdeeeb,stroke:#c0392b,stroke-width:3px,color:#3a0f0a
    class A bom
    class B,C medio
    class D ruim
