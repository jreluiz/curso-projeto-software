    E3["COLABORAÇÃO COM O CLIENTE"] -- "mais que" --- D3["negociação de contratos"]
    E4["RESPONDER A MUDANÇAS"] -- "mais que" --- D4["seguir um plano"]

    classDef esq fill:#0f766e,stroke:#0f766e,stroke-width:3px,color:#ffffff
    classDef dir fill:#e7f2f0,stroke:#0f766e,stroke-width:3px,color:#1a1a1a
    class E1,E2,E3,E4 esq
    class D1,D2,D3,D4 dir
