---
config:
  theme: base
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 20px
    lineColor: "#0f766e"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
  flowchart:
    nodeSpacing: 34
    rankSpacing: 52
    padding: 16
    wrappingWidth: 400
---
flowchart LR
    Q{"os dois lados<br/>competem?"}
    N["o valor NÃO DIZ NADA<br/>e é a maior parte<br/>do tempo"]
    S["prefira o da ESQUERDA<br/>sem anular<br/>o da direita"]

    Q -- "não" --> N
    Q -- "sim" --> S

    classDef perg fill:#e7f2f0,stroke:#0f766e,stroke-width:3px,color:#1a1a1a
    classDef neutro fill:#fdfdfb,stroke:#0f766e,stroke-width:2px,color:#5c5c5c
    classDef vale fill:#0f766e,stroke:#0f766e,stroke-width:3px,color:#ffffff
    class Q perg
    class N neutro
    class S vale
    linkStyle default stroke:#0f766e,stroke-width:3px
