---
config:
  theme: base
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#334155"
    primaryColor: "#f1f5f9"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#334155"
    edgeLabelBackground: "#fdfdfb"
  flowchart:
    nodeSpacing: 22
    rankSpacing: 34
    padding: 12
    wrappingWidth: 600
---
flowchart LR
    Q1{"Sabemos<br/>qual é o<br/>problema?"}
    Q2{"Sabemos se<br/>alguém quer<br/>a solução?"}
    Q3{"Entregamos<br/>mal ou<br/>devagar?"}
    DT["<b>DESIGN THINKING</b>"]
    MVP["<b>MVP</b>"]
    L["<b>LEAN</b><br/>e Six Sigma, se há<br/>dado e repetição"]
    N["nenhuma das três:<br/>siga construindo"]

    Q1 -- "não" --> DT
    Q1 -- "sim" --> Q2
    Q2 -- "não" --> MVP
    Q2 -- "sim" --> Q3
    Q3 -- "sim" --> L
    Q3 -- "não" --> N

    classDef q fill:#f1f5f9,stroke:#334155,stroke-width:3px,color:#1a1a1a
    classDef dt fill:#7c3aed,stroke:#7c3aed,stroke-width:3px,color:#ffffff
    classDef mvp fill:#4338ca,stroke:#4338ca,stroke-width:3px,color:#ffffff
    classDef lean fill:#0f766e,stroke:#0f766e,stroke-width:3px,color:#ffffff
    classDef nada fill:#dcfce7,stroke:#15803d,stroke-width:3px,color:#1a1a1a
    class Q1,Q2,Q3 q
    class DT dt
    class MVP mvp
    class L lean
    class N nada
    linkStyle 0,2 stroke:#b45309,stroke-width:3px
    linkStyle 1,3,4,5 stroke:#334155,stroke-width:3px
