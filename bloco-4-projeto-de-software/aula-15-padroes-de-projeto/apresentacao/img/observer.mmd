---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#0f766e"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
    edgeLabelBackground: "#fdfdfb"
---
classDiagram
    direction LR
    class Agenda {
        +interromper(reserva)
        +registrar(obs)
    }
    class ObservadorDeReserva {
        <<interface>>
        +reservaInterrompida(reserva)
    }
    class EnvioDeEmail
    class RegistroDeAuditoria
    class AvisoNoSistema

    Agenda --> "0..*" ObservadorDeReserva : avisa
    ObservadorDeReserva <|.. EnvioDeEmail
    ObservadorDeReserva <|.. RegistroDeAuditoria
    ObservadorDeReserva <|.. AvisoNoSistema
