---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#0f766e"
    primaryColor: "#fdeeeb"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#c0392b"
    edgeLabelBackground: "#fdfdfb"
---
classDiagram
    class GerenciadorDeReservas {
        +autenticar(usuario, senha)
        +reservar(espaco, periodo)
        +calcularOcupacaoMensal()
        +enviarEmail(destino, texto)
        +formatarData(data)
        +gerarPdfDoRelatorio()
        +conectarAoSistemaAcademico()
    }
