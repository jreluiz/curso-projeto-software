---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#0f766e"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
    edgeLabelBackground: "#fdfdfb"
    clusterBkg: "#fdfdfb"
    clusterBorder: "#0f766e"
---
%% LR de propósito: em TB este diagrama sai alto e estreito,
%% e a classe `diagrama` do Marp o reduz a um filete.
flowchart LR
    S["<b>Sistema<br/>a modelar</b>"]
    S --> E["<b>Visão estática</b><br/><i>o que existe</i>"]
    S --> D["<b>Visão dinâmica</b><br/><i>o que acontece</i>"]
    E --> E1["Classes<br/>Aula 11"]
    D --> D1["Casos de uso<br/>Aula 10"]
    D --> D2["Sequência<br/>Aula 12"]
    D --> D3["Atividades<br/>Aula 12"]
    D --> D4["Estados<br/>Aula 12"]

    classDef raiz fill:#fdf1e6,stroke:#e76f00,stroke-width:3px,color:#3a2000
    classDef fam fill:#e7f2f0,stroke:#0f766e,stroke-width:4px,color:#0f2f2b
    classDef folha fill:#fdfdfb,stroke:#0f766e,stroke-width:2px,color:#1a1a1a
    class S raiz
    class E,D fam
    class E1,D1,D2,D3,D4 folha
