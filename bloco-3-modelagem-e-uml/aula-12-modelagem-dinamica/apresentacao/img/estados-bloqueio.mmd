---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#0f766e"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
    edgeLabelBackground: "#fdfdfb"
---
stateDiagram-v2
    direction LR
    state "Agendado" as agendado
    state "Ativo" as ativo
    state "Encerrado" as encerrado
    state "Cancelado" as cancelado

    [*] --> agendado: infraestrutura registra
    agendado --> ativo: chega o início
    agendado --> cancelado: infraestrutura cancela
    ativo --> encerrado: chega o fim
    ativo --> cancelado: conserto concluído antes
    encerrado --> [*]
    cancelado --> [*]
