---
config:
  theme: base
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 20px
    lineColor: "#0f766e"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
  flowchart:
    nodeSpacing: 26
    rankSpacing: 58
    padding: 16
---
flowchart LR
    D["DESVIO<br/>+12 dias na<br/>2ª entrega"]
    Q{"por que<br/>atrasou?"}
    A["RECUPERAR O PRAZO<br/>custa horas extras<br/>e qualidade"]
    B["CORTAR ESCOPO<br/>custa funcionalidade<br/>que alguém esperava"]
    C["MOVER A DATA<br/>custa credibilidade<br/>e às vezes contrato"]
    X["seguir tentando<br/>não é decisão —<br/>é a falta dela"]

    D --> Q
    Q --> A
    Q --> B
    Q --> C
    D -.-> X

    classDef origem fill:#0f766e,stroke:#0f766e,stroke-width:3px,color:#ffffff
    classDef caixa fill:#e7f2f0,stroke:#0f766e,stroke-width:3px,color:#1a1a1a
    classDef ruim fill:#fbeae7,stroke:#b02a1c,stroke-width:3px,color:#b02a1c
    class D origem
    class Q,A,B,C caixa
    class X ruim
    linkStyle 0,1,2,3 stroke:#0f766e,stroke-width:3.5px
    linkStyle 4 stroke:#b02a1c,stroke-width:2.5px
