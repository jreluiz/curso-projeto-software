---
config:
  theme: base
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 20px
    lineColor: "#0f766e"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
  flowchart:
    nodeSpacing: 30
    rankSpacing: 60
    padding: 16
---
flowchart LR
    C1["Navegador<br/>do atendente"]
    C2["App do<br/>entregador"]
    C3["Painel da<br/>cozinha"]
    S["SERVIDOR<br/>regras e dados<br/>num lugar só"]
    BD[("Banco")]

    C1 --> S
    C2 --> S
    C3 --> S
    S --> BD

    classDef caixa fill:#e7f2f0,stroke:#0f766e,stroke-width:3px,color:#1a1a1a
    classDef nucleo fill:#0f766e,stroke:#0f766e,stroke-width:3px,color:#ffffff
    class C1,C2,C3 caixa
    class S,BD nucleo
    linkStyle default stroke:#0f766e,stroke-width:3.5px
