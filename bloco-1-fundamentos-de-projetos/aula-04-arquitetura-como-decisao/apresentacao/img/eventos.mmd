---
config:
  theme: base
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 20px
    lineColor: "#0f766e"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
  flowchart:
    nodeSpacing: 30
    rankSpacing: 55
    padding: 16
---
flowchart LR
    P["PEDIDO<br/>CONFIRMADO"]
    E{{"evento<br/>publicado"}}
    C["Cozinha<br/>começa a preparar"]
    N["Entregador<br/>é acionado"]
    A["Cliente<br/>recebe o aviso"]

    P --> E
    E --> C
    E --> N
    E --> A

    classDef caixa fill:#e7f2f0,stroke:#0f766e,stroke-width:3px,color:#1a1a1a
    classDef origem fill:#0f766e,stroke:#0f766e,stroke-width:3px,color:#ffffff
    class E,C,N,A caixa
    class P origem
    linkStyle default stroke:#0f766e,stroke-width:3.5px
