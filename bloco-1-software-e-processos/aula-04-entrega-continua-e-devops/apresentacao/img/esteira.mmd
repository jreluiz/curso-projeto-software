---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#0f766e"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
    edgeLabelBackground: "#fdfdfb"
    clusterBkg: "#fdfdfb"
    clusterBorder: "#0f766e"
---
flowchart LR
    C[Commit] --> B[Build]
    B --> TU["Testes de<br/>unidade"]
    TU --> TI["Testes de<br/>integração"]
    TI --> H["Homologação"]
    H --> TA["Testes de<br/>aceite"]
    TA --> AP{"Aprovação<br/>humana"}
    AP -->|libera| P["Produção"]
    B -.->|falhou| C
    TU -.->|falhou| C
    TI -.->|falhou| C
    TA -.->|falhou| C

    classDef auto fill:#e7f2f0,stroke:#0f766e,stroke-width:3px,color:#0f2f2b
    classDef humano fill:#fdf1e6,stroke:#e76f00,stroke-width:3px,color:#3a2000
    class C,B,TU,TI,H,TA auto
    class AP,P humano
