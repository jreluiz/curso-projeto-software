---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#0f766e"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
    edgeLabelBackground: "#fdfdfb"
    clusterBkg: "#fdfdfb"
    clusterBorder: "#0f766e"
---
flowchart LR
    PB[("Product<br/>Backlog")] --> PL["Planejamento"]
    PL --> SB[("Sprint<br/>Backlog")]
    SB --> S["Sprint<br/>1 a 4 semanas"]
    S --> D{{"Daily"}}
    D --> S
    S --> INC["Incremento<br/>funcionando"]
    INC --> RV["Review<br/>com o cliente"]
    RV --> RT["Retrospectiva"]
    RT --> PL
    RV -.->|novos itens| PB

    classDef art fill:#e7f2f0,stroke:#0f766e,stroke-width:3px,color:#0f2f2b
    classDef ev fill:#fdfdfb,stroke:#0f766e,stroke-width:3px,color:#1a1a1a
    class PB,SB,INC art
    class PL,S,D,RV,RT ev
