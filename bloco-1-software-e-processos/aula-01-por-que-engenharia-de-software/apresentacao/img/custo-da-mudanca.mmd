---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#0f766e"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
    edgeLabelBackground: "#fdfdfb"
    clusterBkg: "#fdfdfb"
    clusterBorder: "#0f766e"
---
flowchart LR
    A["Requisitos<br/>1×"] --> B["Projeto<br/>5×"]
    B --> C["Codificação<br/>10×"]
    C --> D["Testes<br/>20×"]
    D --> E["Produção<br/>50× ou mais"]

    classDef barato fill:#e7f2f0,stroke:#0f766e,stroke-width:3px,color:#0f2f2b
    classDef medio fill:#fdf1e6,stroke:#e76f00,stroke-width:3px,color:#3a2000
    classDef caro fill:#fdeeeb,stroke:#c0392b,stroke-width:3px,color:#3a0f0a
    class A,B barato
    class C,D medio
    class E caro
