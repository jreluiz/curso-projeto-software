---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#0f766e"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
    edgeLabelBackground: "#fdfdfb"
    clusterBkg: "#fdfdfb"
    clusterBorder: "#0f766e"
---
flowchart LR
    subgraph I1["Incremento 1"]
      direction TB
      A1[Espec.] --> B1[Projeto] --> C1[Impl.] --> D1[Valid.]
    end
    subgraph I2["Incremento 2"]
      direction TB
      A2[Espec.] --> B2[Projeto] --> C2[Impl.] --> D2[Valid.]
    end
    subgraph I3["Incremento 3"]
      direction TB
      A3[Espec.] --> B3[Projeto] --> C3[Impl.] --> D3[Valid.]
    end
    I1 --> I2 --> I3

    classDef etapa fill:#e7f2f0,stroke:#0f766e,stroke-width:3px,color:#0f2f2b
    class A1,B1,C1,D1,A2,B2,C2,D2,A3,B3,C3,D3 etapa
