---
config:
  theme: base
  # fontFamily precisa ser chave de topo — dentro de themeVariables é ignorada
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#0f766e"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
    edgeLabelBackground: "#fdfdfb"
    clusterBkg: "#fdfdfb"
    clusterBorder: "#0f766e"
---
flowchart LR
    A[Requisitos] --> B[Projeto]
    B --> C[Implementação]
    C --> D[Testes]
    D --> E["Implantação<br/>e manutenção"]

    classDef fase fill:#e7f2f0,stroke:#0f766e,stroke-width:3px,color:#0f2f2b
    class A,B,C,D,E fase
