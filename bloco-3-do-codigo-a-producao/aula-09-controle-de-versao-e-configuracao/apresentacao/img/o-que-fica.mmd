---
config:
  theme: base
  fontFamily: "Helvetica Neue, Helvetica, Arial, sans-serif"
  themeVariables:
    fontSize: 22px
    lineColor: "#334155"
    primaryColor: "#e7f2f0"
    primaryTextColor: "#1a1a1a"
    primaryBorderColor: "#0f766e"
    edgeLabelBackground: "#fdfdfb"
    clusterBkg: "#f8fafc"
    clusterBorder: "#94a3b8"
  flowchart:
    nodeSpacing: 26
    rankSpacing: 46
    padding: 14
    wrappingWidth: 600
---
flowchart LR
    IC["ITENS DE<br/>CONFIGURAÇÃO<br/>tudo o que muda e<br/>tem de quem depende"]
    B["BASELINE<br/>uma tag aprovada<br/>que não muda mais"]
    R["RELEASE<br/>número com significado<br/>e CHANGELOG"]
    IC -- "revisão e<br/>aprovação" --> B
    B -- "publicação" --> R

    classDef ic fill:#e0e7ff,stroke:#4338ca,stroke-width:3px,color:#1a1a1a
    classDef bl fill:#fef3c7,stroke:#b45309,stroke-width:3px,color:#1a1a1a
    classDef rl fill:#0f766e,stroke:#0f766e,stroke-width:3px,color:#ffffff
    class IC ic
    class B bl
    class R rl
    linkStyle 0,1 stroke:#334155,stroke-width:3.5px
